{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci --omit=dev --workspace @pp/api --include-workspace-root",
    "watchPatterns": [
      "apps/api/**",
      "packages/contracts/**",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "SERVE_FRONTEND=false npm start -w @pp/api",
    "healthcheckPath": "/api/health/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
