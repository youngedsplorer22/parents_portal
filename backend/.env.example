# Copy to backend/.env (git-ignored) and replace every CHANGE_ME value.
# Never commit backend/.env. Never point these URLs at the ERP database.

NODE_ENV=development
PORT=4000
# Optional. An IP address to listen on. Unset: development and test listen on 127.0.0.1 only; production listens on
# every interface (what a hosting platform such as Railway needs). Example: HOST=0.0.0.0
# HOST=

# Reverse proxies in FRONT of this server whose X-Forwarded-For entry is trusted. 0 (default, local development): none.
# Railway: set TRUST_PROXY_HOPS=1 on the platform. Never raise it above the real number of proxies: a larger value lets
# callers choose their own "client address" and so dodge every per-IP limit.
# TRUST_PROXY_HOPS=0
# Serve the built frontend (frontend/dist) from this server. Default: on in production, off otherwise (development uses
# `npm run dev` in frontend/, whose Vite proxy forwards /api to this server). FRONTEND_DIST overrides the folder.
# SERVE_FRONTEND=false
# FRONTEND_DIST=
# Database pool, in milliseconds (defaults shown). The statement timeout is enforced by PostgreSQL itself.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# After SIGTERM (every Railway deploy): how long in-flight requests may finish before connections are closed.
# SHUTDOWN_GRACE_MS=10000
# Production ONLY, for the one-time first-admin command (npm run bootstrap:admin); set it for that run, then remove it.
# BOOTSTRAP_ADMIN_ENABLED=true

# Local PostgreSQL only while NODE_ENV is development or test (the server refuses non-localhost hosts).
# Use the parents_portal_app role; its password is stored locally in ~/.pgpass.
# Production (Railway) does NOT use this file: its variables are set on the platform. There DATABASE_URL may point at
# another host, but only with NODE_ENV=production AND ALLOW_PRODUCTION_DATABASE=true, and TEST_DATABASE_URL must NOT
# be set at all. The database must not be a test database. Never put those production values in this file.
# ALLOW_PRODUCTION_DATABASE=true
# Production also refuses the development database (parents_portal_dev) and any *_test database.
# TLS to the database: leave the URL without sslmode (or sslmode=disable) on Railway's private host (*.railway.internal);
# any other remote host needs ?sslmode=verify-full. No other sslmode is accepted. Do not set PGSSLMODE in production.
# Production migrations (npm run migrate:production) also need the database name typed again as a confirmation:
# MIGRATE_CONFIRM_DATABASE=<the database name in DATABASE_URL>
DATABASE_URL=postgresql://parents_portal_app:CHANGE_ME@localhost:5432/parents_portal_dev
TEST_DATABASE_URL=postgresql://parents_portal_app:CHANGE_ME@localhost:5432/parents_portal_test

# Server-side key for hashing OTP codes and verification tokens.
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=replace-with-output-of-openssl-rand-hex-32

# How codes are delivered. There is no default and no fallback; choose one:
#   dev-console  local development only. Prints the code in the backend terminal and sends
#                NO email. Refused unless NODE_ENV=development, and refused if any SMTP_*
#                variable is also set.
#   smtp         real email through your SMTP server (uncomment and fill in every SMTP_* below).
#                If anything is missing or wrong the server refuses to start.
OTP_DELIVERY=dev-console

# SMTP settings, used only when OTP_DELIVERY=smtp. Keep these commented out otherwise.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true = implicit TLS (usually port 465). false = STARTTLS (usually port 587); TLS is then required.
# SMTP_SECURE=false
# SMTP_USER=CHANGE_ME_smtp_username
# SMTP_PASSWORD=CHANGE_ME_smtp_password_or_app_password
# Sender address shown to recipients: an address or "Display Name <address>".
# SMTP_FROM=Young Edsplorer <no-reply@example.com>

# Code lifetime. 300 = 5 minutes.
OTP_TTL_SECONDS=300
# Staff first-time-setup / forgot-password codes (15 minutes). Parents' codes use OTP_TTL_SECONDS above.
# STAFF_OTP_TTL_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_EMAIL_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20
VERIFICATION_TOKEN_TTL_SECONDS=900

# Parent sign-in (see AUTH_SESSIONS.md). Each must fit inside the next: access <= inactivity <= absolute.
# Absolute limit: no sign-in lasts longer, however active (default 604800 = 7 days).
# SESSION_TTL_SECONDS=604800
# Access token, renewed automatically by the page (default 900 = 15 minutes; 60 to 3600).
# PARENT_ACCESS_TOKEN_TTL_SECONDS=900
# Inactivity limit: sign in again after this long without any use (default 259200 = 3 days).
# PARENT_SESSION_IDLE_TIMEOUT_SECONDS=259200
# Two tabs renewing at once within this many seconds is not treated as a stolen token (default 20; 0 to 120).
# REFRESH_REUSE_GRACE_SECONDS=20

# Password sign-in limits: failed attempts allowed per window, per email and per IP.
# PASSWORD_LOGIN_WINDOW_SECONDS=900
# PASSWORD_LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
# PASSWORD_LOGIN_MAX_ATTEMPTS_PER_IP=20

# Password hashing under load: how many hashes run at once, and how many more may wait, before
# sign-ins get "busy, try again in a few seconds" (503). Unset = sized from the machine's CPUs.
# PASSWORD_HASH_CONCURRENCY=3
# PASSWORD_HASH_QUEUE=24

# Where a copy of each submitted registration's PDF is kept. Nothing here is needed to run the portal.
#   disabled      (the default) nothing is stored anywhere; a PDF is made when a parent asks for it.
#   google-drive  a private copy is kept in the Google Drive of GOOGLE_DRIVE_ACCOUNT. Needs the four values below.
#                 Step-by-step setup (Google Cloud Console and the one-time sign-in) is in GOOGLE_DRIVE_SETUP.md at the
#                 project root. If any value is missing the portal still runs and the startup message names what is missing.
# PDF_STORAGE=disabled
# The Google account whose Drive receives the PDFs (change this, then authorise again, to move to another account).
# GOOGLE_DRIVE_ACCOUNT=you@example.com
# From Google Cloud Console: an OAuth client of type "Desktop app".
# GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
# Created for you by:  npm run drive:authorize   (paste the line it prints). Keep it secret; never commit it.
# GOOGLE_DRIVE_REFRESH_TOKEN=CHANGE_ME
# Top folder in that Drive (default Young Edsplorer). Inside it: Parent Registrations / <School> / <Trip> / <reference>.pdf
# GOOGLE_DRIVE_ROOT_FOLDER_NAME=Young Edsplorer

# Internal admin panel (staff). Staff sign-ins last this long (absolute), default 28800 = 8 hours.
# STAFF_SESSION_TTL_SECONDS=28800
# Staff access token (default 900 = 15 minutes) and inactivity limit (default 7200 = 2 hours).
# STAFF_ACCESS_TOKEN_TTL_SECONDS=900
# STAFF_SESSION_IDLE_TIMEOUT_SECONDS=7200
# Where parents open their school link, origin only, e.g. https://parents.example.com .
# If unset, the panel shows the link path and the browser's own address is used for the full URL.
# PUBLIC_BASE_URL=https://parents.example.com
# Per-IP limit on public link lookups (GET /api/join/:token), per minute.
# JOIN_LOOKUPS_PER_MINUTE=30
