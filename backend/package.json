{
  "name": "parents-portal-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Parents Portal backend: email OTP verification for registration",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:local": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "migrate:production": "node src/db/migrate.js --production",
    "test": "node --env-file=.env --test --test-concurrency=1 \"test/**/*.test.js\"",
    "staff": "node --env-file=.env scripts/staff.js",
    "mail:check": "node --env-file=.env scripts/smtp-check.js",
    "catalog:cleanup": "node --env-file=.env scripts/catalog-cleanup.js",
    "drive:authorize": "node --env-file=.env scripts/drive-authorize.js",
    "drive:check": "node --env-file=.env scripts/drive-check.js"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "express": "^5.3.0",
    "fontkit": "2.0.4",
    "helmet": "^8.3.0",
    "nodemailer": "10.0.15",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pdfjs-dist": "6.4.299"
  }
}
