{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/portal-domestic-paid/Dockerfile",
    "watchPatterns": ["apps/portal-domestic-paid/**", "apps/web-server/**", "packages/web-core/**", "packages/contracts/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "PORTAL_ROLE=public STATIC_DIR=apps/portal-domestic-paid/dist node apps/web-server/src/server.js",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
